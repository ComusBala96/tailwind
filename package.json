{
    "name": "@orians/tailwind",
    "version": "2.0.0",
    "homepage": "https://github.com/ComusBala96/tailwind.git",
    "description": "A npm package of tailwind css for OrianSoft.",
    "type": "module",
    "main": "src/tailwind.config.js",
    "types": "src/index.d.ts",
    "exports": {
        ".": {
            "import": "./src/tailwind.config.js",
            "require": "./src/tailwind.config.js",
            "types": "./src/index.d.ts"
        },
        "./postcss": {
            "import": "./src/postcss.config.js",
            "require": "./src/postcss.config.js",
            "types": "./src/postcss.d.ts"
        },
        "./base": {
            "default": "./src/base.css",
            "types": "./src/base.d.ts"
        }
    },
    "files": [
        "base.css",
        "tailwind.config.js",
        "postcss.config.js"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "keywords": [
        "orians",
        "npm",
        "@orians",
        "tailwind",
        "css"
    ],
    "author": {
        "name": "OrianSoft",
        "email": "info@oriansoft.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ComusBala96/tailwind.git"
    },
    "dependencies": {
        "@tailwindcss/aspect-ratio": "^0.4.2",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.4.47",
        "tailwindcss": "^3.4.17"
    }
}